<Group hide-input="false" labelreference="L3" drawlabel="true" applyint="true" applyrational="true" applyexponent="false">
<Input><Text-field prompt="&gt; " style="Maple Input" layout="Normal">EQN1:=-diff(u(x,t),t)+d[u]*diff(u(x,t),x,x)+f(u(x,t),v(x,t));
EQN2:=-diff(v(x,t),t)+d[v]*diff(v(x,t),x,x)+g(u(x,t),v(x,t));
Pert:=exp(lambda*t)*cos(k*x):
up:=us+epsilon[u]*Pert:
vp:=vs+epsilon[v]*Pert:
Perts:={u(x,t)=up,v(x,t)=vp}:
M1:=mtaylor(expand(subs(Perts,EQN1)),[epsilon[u],epsilon[v]],2);
M2:=mtaylor(expand(subs(Perts,EQN2)),[epsilon[u],epsilon[v]],2);
</Text-field>
</Input>
<Output><Text-field style="2D Output" layout="Maple Output"><Equation executable="false" style="2D Output" display=""></Equation></Text-field>
</Output>
<Output><Text-field style="2D Output" layout="Maple Output"><Equation executable="false" style="2D Output" display=""></Equation></Text-field>
</Output>
<Output><Text-field style="2D Output" layout="Maple Output"><Equation executable="false" style="2D Output" display=""></Equation></Text-field>
</Output>
<Output><Text-field style="2D Output" layout="Maple Output"><Equation executable="false" style="2D Output" display=""></Equation></Text-field>
</Output>
</Group>
<Group hide-input="false" labelreference="L4" drawlabel="true" applyint="true" applyrational="true" applyexponent="false">
<Input><Text-field prompt="&gt; " style="Maple Input" layout="Normal">M:=Matrix([[ coeff(M1,epsilon[u]) , coeff(M1,epsilon[v]) ],
        [ coeff(M2,epsilon[u]) , coeff(M2,epsilon[v]) ]])/Pert;
subs({op(SS),k=0,lambda=0},M);
Trace(%)&lt;0;
Determinant(%%)&lt;0;
subs({op(SS),lambda=0},M):
Trace(%);
